{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "seltra-sandbox-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "WorkspaceSandbox",
      "scheduling_policy": "durable_object",
      "images": {
        "base": { "dockerfile": "./image/Dockerfile", "build_context": "./image" }
      }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SANDBOXES", "class_name": "WorkspaceSandbox" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorkspaceSandbox"] }],
  "observability": { "enabled": true }
}
