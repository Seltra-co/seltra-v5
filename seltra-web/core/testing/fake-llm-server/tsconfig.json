{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022"],
    "module": "commonjs",
    "outDir": "dist",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["*.ts"],
  "exclude": ["node_modules"]
}
