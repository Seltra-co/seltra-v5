# Environment variables for Seltra Core local development.
# To use, copy this file to a new file named ".env" and fill in your private keys and settings.
# Your actual .env file should NOT be committed.

# AI Provider API Keys(Optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=


# Local AI Model Configuration (Optional)
# Set these if you are running local AI models like Ollama or LM Studio.
# Default for Ollama is http://127.0.0.1:11434
OLLAMA_HOST=

# GitHub Integration (Optional)
# Needed for features that interact with GitHub repositories.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=


# Apple Notarization (macOS Build Only)
# Only required if you are building and signing a release version for macOS.
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=
SM_CODE_SIGNING_CERT_SHA1=


# Development & Testing Variables (Advanced)
# These are typically not needed for standard contribution.
# NODE_ENV=development
# E2E_TEST_BUILD=
# CI=
# DYAD_ENGINE_URL=
# Seltra Engine endpoint/key are configured in .env.web for web mode.
# SELTRA_ENGINE_URL=http://localhost:3001/v1
# SELTRA_ENGINE_API_KEY=
# DYAD_GATEWAY_URL=
# Where the bug-report form gets signed URLs for screenshots
# (dyad-image-uploader). Point it at a local copy of that service to test
# the report flow against a bucket you own: http://localhost:8080
# VITE_IMAGE_UPLOAD_SERVICE_ORIGIN=

# Seltra Core gateway (server only; identity/entitlement secrets match backend/.env)
CORE_TOKEN_SECRET=
CORE_SERVICE_SECRET=
NEST_INTERNAL_URL=http://localhost:3001
SELTRA_PUBLIC_API_URL=http://localhost:3001/api/v1
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000
# Mirrors the backend's per-plan account token allowances.
MODEL_MAX_TOKENS_PER_WORKSPACE=20000000
SELTRA_PRO_MAX_TOKENS_PER_WORKSPACE=100000000
DATA_ROOT=
AI_PROVIDER=
AI_MODEL_DEFAULT=
AI_MODEL_REASONING=
AI_MODEL_FAST=
AI_MODEL_VISION=
AI_MODEL_IMAGE=
MODEL_API_KEY=
MODEL_ACCOUNT_ID=
MODEL_BASE_URL=
DATABASE_URL=
RUNTIME_RPC_SECRET=
RUNTIME_SECRETS_KEY=
DYAD_USER_DATA=
DYAD_APPS_DIR=
DYAD_TMP_DIR=
RUNTIME_RPC_HOST=127.0.0.1
RUNTIME_RPC_PORT=
PREVIEW_BASE_DOMAIN=
GITHUB_ORG=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# V5 run lifecycle and resilience
RUN_LEASE_TTL_SECONDS=30
RUN_HEARTBEAT_INTERVAL_SECONDS=5
STREAM_HEARTBEAT_SECONDS=10
STALL_NOTICE_SECONDS=20
STALL_DIAGNOSTIC_SECONDS=90
MAX_REPAIR_ATTEMPTS=3

# V5 concurrency / projects
MAX_CONCURRENT_RUNS_PER_WORKSPACE=2
SANDBOX_IDLE_REAP_MINUTES=20

# V5 credits
CREDITS_LOW_THRESHOLD_PCT=20
CREDITS_MIN_CHARGE_PER_CALL=1
CREDIT_WEIGHT_REASONING=1
CREDIT_WEIGHT_DEFAULT=1
CREDIT_WEIGHT_FAST=1
CREDIT_WEIGHT_VISION=2
CREDIT_WEIGHT_IMAGE=3

# V5 feature flags
FF_RESUMABLE_STREAM=true
FF_WORKSPACE_PERSISTENCE=true
FF_CREDITS_METERING=true
FF_COMPLETION_SOUND=true
