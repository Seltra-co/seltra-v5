# Gateway identity and Nest service boundary. Match both secrets in backend/.env.
CORE_TOKEN_SECRET=
CORE_SERVICE_SECRET=
NEST_INTERNAL_URL=http://localhost:3001
SELTRA_PUBLIC_API_URL=http://localhost:3001/api/v1
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000

# Required to call a real model. Leave blank to run the UI without chat.
AI_PROVIDER=cloudflare
AI_MODEL_DEFAULT=@cf/moonshotai/kimi-k2.7-code
# Used in order by the Seltra Builder when its primary Cloudflare model is unavailable.
AI_MODEL_FALLBACKS=alibaba/qwen3.5-397b-a17b,@cf/qwen/qwen2.5-coder-32b-instruct,@cf/deepseek-ai/deepseek-r1-distill-qwen-32b
AI_MODEL_TOOL_FALLBACKS=alibaba/qwen3.5-397b-a17b
AI_MODEL_REASONING=
AI_MODEL_FAST=
AI_MODEL_VISION=
AI_MODEL_IMAGE=
# Optional read-only Figma personal access token; passed to the gateway only.
FIGMA_ACCESS_TOKEN=
SELTRA_ORCHESTRATION_ENABLED=0
SELTRA_DESIGN_INTELLIGENCE_ENABLED=0
SELTRA_BROWSER_QA_ENABLED=0
SELTRA_MULTIMODAL_INPUT_ENABLED=0
SELTRA_BUILDER_FALLBACK_MAX_OUTPUT_TOKENS=8192
MODEL_API_KEY=
MODEL_MAX_TOKENS_PER_RUN=6000000
MODEL_MAX_TOKENS_PER_WORKSPACE=6000000
MODEL_ACCOUNT_ID=
MODEL_BASE_URL=

# Preview routing; workspace keys are embedded in preview hostnames.
PREVIEW_BASE_DOMAIN=localhost
PREVIEW_PUBLIC_SCHEME=http
PREVIEW_PUBLIC_PORT=8080
PREVIEW_TOKEN_TTL=5m
PREVIEW_SESSION_TTL_SECONDS=28800

# Persistent runtime disk. Set to /var/data on Render.
DATA_ROOT=
MAX_ACTIVE_WORKSPACES=4
WORKSPACE_IDLE_TTL_SECONDS=1800

# Optional hosted control-plane database. M1 defaults to .web-dev/control JSONL.
DATABASE_URL=
