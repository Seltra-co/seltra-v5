# Copy to .env.web for local development. Secret values are intentionally blank.
NODE_ENV=development
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000

# These two values must exactly match Backend .env.
CORE_TOKEN_SECRET=
CORE_SERVICE_SECRET=
NEST_INTERNAL_URL=http://localhost:3001

# Runtime execution always goes through the deployed Cloudflare sandbox gateway.
EXECUTION_PROVIDER=cloudflare
SANDBOX_GATEWAY_URL=
SANDBOX_GATEWAY_SIGNING_SECRET=
CORE_PUBLIC_URL=

# Keep live publish off until disposable provider and persistence gates pass.
DEPLOY_MODE=team
PUBLISH_ENABLED=false
WORKSPACE_PERSISTENCE_ENABLED=false
WORKSPACE_RESTORE_ENABLED=false
WORKSPACE_ROOT=C:/Temp/seltra-v5-workspaces
PUBLISH_PUBLIC_API_URL=
PUBLISH_ROOT_DOMAIN=seltra.co

# GitHub App, Vercel, and R2 secrets (required only when the related feature is enabled).
GITHUB_ORG=
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_S3_API_ENDPOINT=
R2_BUCKET_ROUTES=
R2_BUCKET_WORKSPACES=
WORKSPACE_MASTER_KEY=
PUBLISH_GIT_AUTHOR_NAME=
PUBLISH_GIT_AUTHOR_EMAIL=

# Local preview/model configuration. Set model credentials in this ignored file only.
PREVIEW_BASE_DOMAIN=localhost
SELTRA_PUBLIC_API_URL=http://localhost:3001/api/v1
AI_PROVIDER=cloudflare
MODEL_API_KEY=
MODEL_ACCOUNT_ID=
MODEL_BASE_URL=
