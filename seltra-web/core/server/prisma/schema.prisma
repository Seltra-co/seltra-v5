generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String      @id @default(cuid())
  email     String      @unique
  createdAt DateTime    @default(now())
  workspaces Workspace[]
}

model Workspace {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id])
  status       String
  runtimeUrl   String?
  createdAt    DateTime        @default(now())
  usage        UsageEvent[]
  publications Publication[]
  repairs      RepairAttempt[]
}

model UsageEvent {
  id                 String    @id @default(cuid())
  workspaceId        String
  workspace          Workspace @relation(fields: [workspaceId], references: [id])
  role               String
  model              String
  inputTokens        Int
  outputTokens       Int
  cachedInputTokens  Int       @default(0)
  ok                 Boolean
  errorClass         String?
  latencyMs          Int
  runId              String?
  estimated          Boolean   @default(false)
  createdAt          DateTime  @default(now())
}

model RepairAttempt {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  runId       String
  failureClass String
  fingerprint String
  attemptNo   Int
  filesTouched Int
  outcome     String
  createdAt   DateTime  @default(now())
}

model Publication {
  id               String    @id @default(cuid())
  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id])
  commitSha        String
  state            String
  repoName         String?
  vercelProjectId  String?
  deploymentId     String?
  url              String?
  lastError        String?
  idempotencyKey   String    @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}
