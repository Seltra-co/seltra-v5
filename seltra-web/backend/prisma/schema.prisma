generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum DeploymentStatus {
  QUEUED
  PREPARING_WORKSPACE
  SAVING_SOURCE
  BUILDING
  VERIFYING
  ACTIVATING
  LIVE
  FAILED
  SUPERSEDED
  DISABLED
}

enum DeploymentKind {
  PUBLISH
  ROLLBACK
}

enum PublishDeployMode {
  hobby
  team
}

enum PublishRepoVisibility {
  public
  private
}

enum PublishSourceState {
  COMPLETE
  INTERRUPTED
}

enum PublishPersistenceStatus {
  OK
  PENDING
  DEGRADED
}

enum WorkspacePersistenceOperationStatus {
  PERSISTING
  SOURCE_VERIFIED
  SNAPSHOT_VERIFIED
  SAFE_TO_DESTROY
  DEGRADED
}

enum PublishWorkspaceStatus {
  ACTIVE
  IDLE
  PERSISTING
  SAFE_TO_DESTROY
  EVICTED
  RESTORING
  FAILED
}

enum PublishPublicationStatus {
  UNPUBLISHED
  PUBLISHED
  UNPUBLISHING
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String
  name         String?

  application                  MerchantApplication?
  tenants                      Tenant[]
  notifications                UserNotification[]
  scheduledEmails              ScheduledEmail[]
  refreshTokens                RefreshToken[]
  marketingEmailUnsubscribedAt DateTime?
  plan                         String               @default("free")
  creditAccount                UserCredit?
  completedTours               String[]             @default([])
  dismissedAnnouncements       String[]             @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Tenant {
  id                             String                          @id @default(uuid())
  coreWorkspaceKey               String?                         @unique
  creditWorkspaceId              String?
  creditWorkspace                WorkspaceCredit?                @relation(fields: [creditWorkspaceId], references: [workspaceId], onDelete: Restrict)
  ownerId                        String?
  owner                          User?                           @relation(fields: [ownerId], references: [id])
  name                           String
  slug                           String                          @unique
  businessType                   String?
  city                           String?
  country                        String?
  targetAudience                 String?
  platform                       String                          @default("Seltra")
  status                         String                          @default("active")
  canonical                      Json
  storeUrl                       String?
  storefrontCode                 String?
  storefrontVersion              Int                             @default(0)
  storefrontGeneratedAt          DateTime?
  manifest                       Json?
  heroSource                     String?
  heroGeneratedAt                DateTime?
  heroSnapshotUrl                String?
  heroSnapshotUpdatedAt          DateTime?
  navSource                      String?
  navGeneratedAt                 DateTime?
  storeDNA                       Json?
  merchantContext                Json? // stores MerchantContext object
  merchantMemory                 Json?
  brandVoice                     Json?
  preferences                    Json?
  payoutMethod                   String?
  payoutProvider                 String?
  payoutProviderCode             String?
  payoutAccount                  String?
  payoutAccountName              String?
  payoutValidatedAt              DateTime?
  agentSettings                  Json?
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  categories                     Category[]
  customers                      Customer[]
  ledger                         MerchantLedger?
  orders                         Order[]
  paymentProviders               PaymentProvider[]
  products                       Product[]
  shippingZones                  ShippingZone[]
  events                         TenantEvent[]
  notifications                  UserNotification[]
  invoices                       Invoice[]
  agentEvents                    AgentEvent[]
  pendingAgentAction             AgentPendingAction?
  manifestPatchLogs              ManifestPatchLog[]
  knowledgeChunks                StoreKnowledgeChunk[]
  disbursements                  Disbursement[]
  marketingMessages              MarketingMessage[]
  marketingTemplates             MarketingTemplate[]
  apps                           TenantApp[]
  seltraEngineApiKeys            SeltraEngineApiKey[]
  workspacePersistenceOperations WorkspacePersistenceOperation[]

  aiCreditsUsed        Int      @default(0)
  aiCreditsWindowStart DateTime @default(now())

  fulfillmentMode    String? @default("delivery") // "delivery" | "pickup" | "both"
  contactPhone       String?
  pickupAddress      String?
  pickupInstructions String?
  deliveryDays       String? // e.g. "Tuesdays and Thursdays" — free text, merchant-set
  deliveryEstimate   String? // e.g. "2-5 business days" — free text
  deliveryFeeNote    String? // e.g. "Affordable rates based on your location"
  // Array<{ id: string, label: string, description: string, priceFrom: number, currency: string, areas?: string[], etaLabel?: string }>
  deliveryTiers      Json?

  @@index([ownerId])
}

model TenantApp {
  id                        String                   @id @default(uuid())
  tenantId                  String
  tenant                    Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  coreAppId                 Int
  corePath                  String?
  name                      String
  status                    String                   @default("draft")
  previewUrl                String?
  publishedUrl              String?
  lastCommitSha             String?
  githubRepoId              String?
  githubRepoFullName        String?
  repoUrl                   String?
  githubRepoVisibility      PublishRepoVisibility?
  githubDefaultBranch       String                   @default("main")
  lastPushedSha             String?
  commitSha                 String?
  lastPushedAt              DateTime?
  lastPushError             String?
  sourceState               PublishSourceState?
  persistenceStatus         PublishPersistenceStatus @default(OK)
  vercelProjectId           String?
  vercelProjectName         String?
  deploymentUrl             String?
  publicationStatus         PublishPublicationStatus @default(UNPUBLISHED)
  liveDeploymentId          String?
  lastKnownGoodDeploymentId String?
  activePublishId           String?                  @unique
  editLeaseHolderSessionId  String?
  editLeaseExpiresAt        DateTime?
  workspaceStatus           PublishWorkspaceStatus   @default(ACTIVE)
  lastSnapshotAt            DateTime?
  version                   Int                      @default(0)
  blueprint                 Json?
  appManifest               Json?
  heroSnapshotUrl           String?
  heroSnapshotUpdatedAt     DateTime?
  blueprintApprovedAt       DateTime?
  deployments               Deployment[]
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  @@unique([tenantId, coreAppId])
  @@index([tenantId])
}

model WorkspacePersistenceOperation {
  id              String                              @id @default(cuid())
  tenantId        String
  tenant          Tenant                              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceKey    String
  operationId     String
  reason          String
  status          WorkspacePersistenceOperationStatus @default(PERSISTING)
  githubRevisions Json?
  snapshotVersion String?
  manifestKey     String?
  bundleKey       String?
  bundleSha256    String?
  errorCode       String?
  completedAt     DateTime?
  createdAt       DateTime                            @default(now())
  updatedAt       DateTime                            @updatedAt

  @@unique([tenantId, operationId])
  @@index([workspaceKey, status, updatedAt])
  @@index([tenantId, createdAt])
}

model WorkspaceCleanup {
  id             String   @id @default(cuid())
  projectId      String
  workspaceKey   String   @unique
  attempts       Int      @default(0)
  nextAttemptAt  DateTime @default(now())
  lastErrorCode  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([nextAttemptAt])
}

model Deployment {
  id                   String                 @id @default(cuid())
  tenantId             String
  tenantAppId          String
  tenantApp            TenantApp              @relation(fields: [tenantAppId], references: [id], onDelete: Cascade)
  slug                 String
  kind                 DeploymentKind         @default(PUBLISH)
  status               DeploymentStatus       @default(QUEUED)
  idempotencyKey       String?
  triggeredByUserId    String
  sourceCommitSha      String?
  vercelProjectId      String?
  vercelDeploymentId   String?
  vercelOrigin         String?
  healthStatus         String?
  healthCheckedAt      DateTime?
  verifiedAt           DateTime?
  publicVerifiedAt     DateTime?
  rollbackSourceId     String?
  previousDeploymentId String?
  errorCode            String?
  errorMessage         String?
  buildLogTail         String?
  lastEventSeq         Int                    @default(0)
  queueLeaseOwner      String?
  queueLeaseToken      String?
  queueLeaseExpiresAt  DateTime?
  attemptCount         Int                    @default(0)
  vercelRequestedAt    DateTime?
  timings              Json?
  deployMode           PublishDeployMode      @default(team)
  repoVisibility       PublishRepoVisibility?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  liveAt               DateTime?
  finishedAt           DateTime?
  events               PublishEvent[]

  @@unique([tenantAppId, idempotencyKey])
  @@index([tenantAppId, createdAt])
  @@index([slug, status])
  @@index([tenantId, createdAt])
  @@index([status, queueLeaseExpiresAt, createdAt])
  @@index([vercelRequestedAt])
}

model PublishEvent {
  id           String           @id @default(cuid())
  deploymentId String
  deployment   Deployment       @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  seq          Int
  status       DeploymentStatus
  message      String?
  data         Json?
  createdAt    DateTime         @default(now())

  @@unique([deploymentId, seq])
  @@index([deploymentId, createdAt])
}

model PublishProviderEvent {
  id                   String   @id @default(cuid())
  provider             String
  projectId            String
  deploymentId         String
  eventType            String
  reconciliationStatus String   @default("DETECTED")
  readyState           String?
  url                  String?
  sourceSha            String?
  firstSeenAt          DateTime @default(now())
  lastSeenAt           DateTime @updatedAt

  @@unique([provider, deploymentId])
  @@index([projectId, firstSeenAt])
}

model ScheduledEmail {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign    String
  status      String    @default("pending")
  scheduledAt DateTime
  claimedAt   DateTime?
  attempts    Int       @default(0)
  sentAt      DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, campaign])
  @@index([status, scheduledAt])
  @@index([status, claimedAt])
}

model AgentPendingAction {
  id        String   @id @default(uuid())
  tenantId  String   @unique
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind      String
  payload   Json
  createdAt DateTime @default(now())
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model TenantEvent {
  id           String            @id @default(uuid())
  tenantId     String
  type         TenantEventType
  meta         Json?
  createdAt    DateTime          @default(now())
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notification UserNotification?

  @@index([tenantId, createdAt])
  @@index([type, createdAt])
}

model UserNotification {
  id            String          @id @default(uuid())
  userId        String
  tenantId      String?
  tenantEventId String?         @unique
  type          TenantEventType
  meta          Json?
  createdAt     DateTime        @default(now())
  readAt        DateTime?
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant        Tenant?         @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  tenantEvent   TenantEvent?    @relation(fields: [tenantEventId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([tenantId, createdAt])
}

model OpsAuditLog {
  id         String   @id @default(uuid())
  actorLabel String
  action     String
  targetType String
  targetId   String
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorLabel, createdAt])
}

model Conversation {
  id        String    @id
  title     String
  userId    String    @map("user_id")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  messages  Message[]

  @@index([userId, updatedAt(sort: Desc)], map: "Conversation_user_updated_idx")
  @@map("Conversation")
}

model Message {
  id             String       @id
  conversationId String       @map("conversation_id")
  userId         String       @map("user_id")
  role           String
  content        String
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt], map: "Message_conversation_created_idx")
  @@map("Message")
}

model Category {
  id       String @id @default(uuid())
  tenantId String
  name     String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
}

model Product {
  id          String           @id @default(uuid())
  tenantId    String
  name        String
  description String?
  price       Decimal          @db.Decimal(10, 2)
  currency    String           @default("GHS")
  category    String?
  sku         String?
  tags        Json?
  status      String           @default("active")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  images      ProductImage[]
  variants    ProductVariant[]
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  url       String
  isPrimary Boolean @default(false)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  name      String
  value     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model GeneratedImageCache {
  id         String   @id @default(uuid())
  promptHash String   @unique
  prompt     String
  model      String
  url        String
  createdAt  DateTime @default(now())

  @@index([promptHash])
}

model PaymentProvider {
  id       String @id @default(uuid())
  tenantId String
  provider String
  config   Json?
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
}

model ShippingZone {
  id           String  @id @default(uuid())
  tenantId     String
  name         String
  deliveryTime String?
  fee          String?
  metadata     Json?
  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
}

model Order {
  id              String              @id @default(uuid())
  tenantId        String
  customerId      String?
  customerEmail   String
  customerName    String?
  customerPhone   String?
  shippingAddress String?
  shippingCity    String?
  shippingCountry String?
  marketingOptIn  Boolean             @default(false)
  totalAmount     Decimal             @db.Decimal(10, 2)
  currency        String              @default("GHS")
  status          String              @default("pending")
  paystackRef     String?
  items           Json
  disbursed       Boolean             @default(false)
  disbursedAt     DateTime?
  seltraFee       Decimal?            @db.Decimal(10, 2)
  merchantAmount  Decimal?            @db.Decimal(10, 2)
  lastReminderAt  DateTime?
  fulfilledBy     String?
  trackingNumber  String?
  timeline        Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  ledgerTx        LedgerTransaction[]
  customer        Customer?           @relation(fields: [customerId], references: [id])
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerEmail])
  @@index([customerId])
}

model Customer {
  id               String    @id @default(uuid())
  tenantId         String
  email            String
  name             String?
  phone            String?
  address          String?
  city             String?
  country          String?
  marketingOptIn   Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders           Order[]
  lastContactedAt  DateTime?
  lifetimeValue    Decimal?  @db.Decimal(12, 2)
  preferredChannel String?
  notes            String?

  @@unique([tenantId, email])
  @@index([tenantId, updatedAt])
}

model MerchantLedger {
  id            String              @id @default(uuid())
  tenantId      String              @unique
  balance       Decimal             @default(0) @db.Decimal(12, 2)
  currency      String              @default("GHS")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  transactions  LedgerTransaction[]
  disbursements Disbursement[]
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model LedgerTransaction {
  id          String         @id @default(uuid())
  ledgerId    String
  orderId     String?
  type        String
  amount      Decimal        @db.Decimal(12, 2)
  currency    String         @default("GHS")
  description String?
  meta        Json?
  createdAt   DateTime       @default(now())
  ledger      MerchantLedger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  order       Order?         @relation(fields: [orderId], references: [id])
}

model Disbursement {
  id            String         @id @default(uuid())
  tenantId      String
  ledgerId      String
  amount        Decimal        @db.Decimal(12, 2)
  currency      String         @default("GHS")
  status        String         @default("pending_otp")
  provider      String?
  providerCode  String?
  account       String
  accountName   String?
  externalRef   String         @unique
  transactionId String?
  rawResponse   Json?
  otpHash       String?
  otpExpiresAt  DateTime?
  confirmedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ledger        MerchantLedger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([status])
}

model Invoice {
  id            String        @id @default(uuid())
  tenantId      String
  number        String
  customerName  String
  customerEmail String
  subtotal      Decimal       @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  currency      String        @default("GHS")
  status        String        @default("draft")
  dueDate       DateTime?
  pdfUrl        String?
  sentAt        DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items         InvoiceItem[]

  @@unique([tenantId, number])
  @@index([tenantId, createdAt])
  @@index([status, dueDate])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model AgentEvent {
  id        String   @id @default(uuid())
  tenantId  String?
  agent     String
  type      String
  action    String?
  payload   Json?
  status    String   @default("recorded")
  createdAt DateTime @default(now())
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([agent, createdAt])
}

model ManifestPatchLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patch     Json
  before    Json
  after     Json
  source    String   @default("chat")
  reverted  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

model StoreKnowledgeChunk {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind      String
  sourceId  String?
  content   String
  metadata  Json?
  updatedAt DateTime @updatedAt

  @@unique([tenantId, kind, sourceId])
  @@index([tenantId, kind])
}

model MarketingMessage {
  id             String   @id @default(uuid())
  tenantId       String
  channel        String
  audience       String
  subject        String?
  message        String
  recipientCount Int      @default(0)
  sent           Int      @default(0)
  failed         Int      @default(0)
  status         String   @default("sent")
  customerId     String?
  customerName   String?
  createdAt      DateTime @default(now())
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([channel, status])
}

model MarketingTemplate {
  id        String   @id @default(uuid())
  tenantId  String
  channel   String
  name      String
  subject   String?
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, updatedAt])
}

model PaystackEvent {
  id            String   @id @default(uuid())
  reference     String   @unique
  event         String
  tenantSlug    String?
  tenantId      String?
  amount        Decimal  @db.Decimal(12, 2)
  currency      String   @default("GHS")
  customerEmail String?
  customerName  String?
  rawPayload    Json
  processed     Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model MerchantApplication {
  id                     String         @id @default(uuid())
  fullName               String
  phone                  String
  email                  String         @unique
  businessName           String
  businessType           String
  storeName              String
  whatYouSell            String
  basedIn                String? //(legacy city/state/country)
  region                 String?
  country                String?
  city                   String?
  monthlyRevenue         String
  existingLinks          String?
  aiFamiliarity          String?
  aiUsedBefore           Boolean?
  aiToolsUsed            String?
  aiFeelings             String?
  allowAiHelp            String?
  status                 MerchantStatus @default(pending)
  merchantId             String?        @unique
  userId                 String?        @unique
  user                   User?          @relation(fields: [userId], references: [id])
  createdBy              String?
  reviewNotes            String?
  reviewedAt             DateTime?
  credentialsGeneratedAt DateTime?
  welcomeEmailSentAt     DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([status])
  @@index([merchantId])
}

model Run {
  id              String            @id @default(uuid())
  projectId       String
  workspaceId     String?
  userId          String?
  state           String            @default("queued")
  phase           String?
  startedAt       DateTime          @default(now())
  endedAt         DateTime?
  lastEventSeq    Int               @default(0)
  lastHeartbeatAt DateTime          @default(now())
  leaseOwner      String?
  checkpoint      Json?
  error           Json?
  idempotencyKey  String?
  resumesRunId    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  events          RunEvent[]
  projectFiles    ProjectFile[]
  snapshots       ProjectSnapshot[]

  @@unique([idempotencyKey])
  @@index([projectId, state])
  @@index([workspaceId, state])
  @@index([lastHeartbeatAt])
  @@map("runs")
}

model RunEvent {
  id      String   @id @default(uuid())
  runId   String
  seq     Int
  ts      DateTime @default(now())
  type    String
  phase   String?
  agent   String?
  payload Json
  run     Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, seq])
  @@index([runId, seq])
  @@map("run_events")
}

model ProjectFile {
  projectId     String
  path          String
  contentHash   String
  size          Int
  mime          String?
  storageRef    String?
  inlineContent String?
  updatedAt     DateTime @updatedAt
  lastRunId     String?
  run           Run?     @relation(fields: [lastRunId], references: [id], onDelete: SetNull)

  @@id([projectId, path])
  @@index([projectId, updatedAt])
  @@map("project_files")
}

model ProjectSnapshot {
  id        String   @id @default(uuid())
  projectId String
  runId     String
  label     String
  manifest  Json
  kind      String   @default("auto")
  createdAt DateTime @default(now())
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("project_snapshots")
}

model WorkspaceCredit {
  workspaceId        String               @id
  balance            Int                  @default(0)
  lifetimeGranted    Int                  @default(0)
  lifetimeUsed       Int                  @default(0)
  windowStartedAt    DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  ledger             CreditLedger[]
  tenants            Tenant[]
  seltraEngineKeys   SeltraEngineApiKey[]
  seltraEngineUsage  SeltraEngineUsage[]
  seltraEngineAssets SeltraEngineAsset[]

  @@map("workspace_credits")
}

model CreditLedger {
  id           String          @id @default(uuid())
  workspaceId  String
  runId        String?
  projectId    String?
  kind         String
  delta        Int
  balanceAfter Int
  modelRole    String?
  tokensIn     Int             @default(0)
  tokensOut    Int             @default(0)
  meta         Json?
  createdAt    DateTime        @default(now())
  workspace    WorkspaceCredit @relation(fields: [workspaceId], references: [workspaceId], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([runId])
  @@map("credit_ledger")
}

model UserCredit {
  userId          String             @id
  balance         Int                @default(0)
  lifetimeGranted Int                @default(0)
  lifetimeUsed    Int                @default(0)
  windowStartedAt DateTime           @default(now())
  windowAllowance Int                @default(0)
  plan            String             @default("free")
  updatedAt       DateTime           @updatedAt
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger          UserCreditLedger[]

  @@map("user_credits")
}

model UserCreditLedger {
  id           String     @id @default(uuid())
  userId       String
  runId        String?
  projectId    String?
  kind         String
  delta        Int
  balanceAfter Int
  modelRole    String?
  tokensIn     Int        @default(0)
  tokensOut    Int        @default(0)
  meta         Json?
  createdAt    DateTime   @default(now())
  account      UserCredit @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([runId])
  @@map("user_credit_ledger")
}

model FileBlob {
  hash    String @id
  content String

  @@map("file_blobs")
}

model ProjectAsset {
  id          String   @id @default(uuid())
  projectId   String
  kind        String
  sourceUrl   String?
  prompt      String?
  license     String?
  attribution String?
  storageRef  String?
  createdAt   DateTime @default(now())

  @@index([projectId, createdAt])
  @@map("project_assets")
}

model SeltraEngineApiKey {
  id           String              @id @default(uuid())
  workspaceId  String
  tenantId     String?
  label        String
  keyHash      String              @unique
  encryptedKey String?
  revokedAt    DateTime?
  lastUsedAt   DateTime?
  createdAt    DateTime            @default(now())
  workspace    WorkspaceCredit     @relation(fields: [workspaceId], references: [workspaceId], onDelete: Cascade)
  tenant       Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usage        SeltraEngineUsage[]
  assets       SeltraEngineAsset[]

  @@index([workspaceId, revokedAt])
  @@index([tenantId, revokedAt])
  @@map("seltra_engine_api_keys")
}

model SeltraEngineUsage {
  id          String             @id @default(uuid())
  keyId       String
  workspaceId String
  route       String
  modelRole   String
  tokensIn    Int                @default(0)
  tokensOut   Int                @default(0)
  images      Int                @default(0)
  costUnits   Int                @default(0)
  requestId   String
  createdAt   DateTime           @default(now())
  key         SeltraEngineApiKey @relation(fields: [keyId], references: [id], onDelete: Cascade)
  workspace   WorkspaceCredit    @relation(fields: [workspaceId], references: [workspaceId], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([keyId, createdAt])
  @@index([requestId])
  @@map("seltra_engine_usage")
}

model SeltraEngineAsset {
  id          String             @id @default(uuid())
  keyId       String
  workspaceId String
  prompt      String
  model       String
  mimeType    String
  sizeBytes   Int
  storageRef  String
  createdAt   DateTime           @default(now())
  key         SeltraEngineApiKey @relation(fields: [keyId], references: [id], onDelete: Cascade)
  workspace   WorkspaceCredit    @relation(fields: [workspaceId], references: [workspaceId], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("seltra_engine_assets")
}

model OtpCode {
  id          String    @id @default(uuid())
  merchantId  String
  hashedCode  String
  expiresAt   DateTime
  used        Boolean   @default(false)
  attempts    Int       @default(0)
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())

  @@index([merchantId])
  @@index([expiresAt])
}

enum MerchantStatus {
  pending
  approved
  rejected
  suspended
}

enum TenantEventType {
  product_added
  order_placed
  order_status_updated
  payment_received
  invoice_created
  invoice_paid
  invoice_sent
  order_reminder
  sales_summary
  login
  settings_changed
  theme_updated
  ai_invocation
  merchant_onboarded
  disbursement_requested
  disbursement_paid
}
