# Neon Postgres: use the pooled URL for runtime and the direct URL for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/seltra?sslmode=require&connect_timeout=15&pool_timeout=30
DIRECT_URL=postgresql://USER:PASSWORD@ep-example.us-east-2.aws.neon.tech/seltra?sslmode=require&connect_timeout=15&pool_timeout=30
JWT_SECRET=change-me
PORT=3001
# Seltra Engine (served by this same backend process)
SELTRA_ENGINE_PORT=3001
SELTRA_ENGINE_BASE_PATH=/v1
SELTRA_ENGINE_API_KEY_HASH_SALT=generate-a-random-value-of-at-least-32-bytes
SELTRA_ENGINE_BOOTSTRAP_KEY=
SELTRA_ENGINE_BOOTSTRAP_WORKSPACE=local-dev
SELTRA_ENGINE_BOOTSTRAP_CREDITS=1000
SELTRA_ENGINE_ALLOW_BOOTSTRAP=false
SELTRA_ENGINE_MAX_BODY_MB=20
SELTRA_ENGINE_MAX_UPSTREAM_MB=16
SELTRA_ENGINE_RATE_LIMIT_PER_MINUTE=60
SELTRA_ENGINE_MAX_IMAGES_PER_REQUEST=4
SELTRA_ENGINE_UPSTREAM_TIMEOUT_MS=60000
SELTRA_ENGINE_STORAGE_DIR=./storage/engine
SELTRA_ENGINE_PROMPT_DENYLIST=
ENGINE_IMAGE_CREDIT_COST=3
AI_PROVIDER=cloudflare
AI_MODEL_DEFAULT=
AI_MODEL_REASONING=
AI_MODEL_FAST=
AI_MODEL_VISION=
AI_MODEL_IMAGE=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CORE_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
CORE_SERVICE_SECRET=replace-with-a-different-random-secret-at-least-32-characters
CORE_PUBLIC_URL=http://localhost:8080
SELTRA_LLM_PRODUCTS=false
SELTRA_REMOTE_PRODUCT_IMAGES=false
UNSPLASH_ACCESS_KEY=
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=
SELTRA_FEE_PERCENT=0
SELTRA_IMAGE_PROVIDER=cloudflare
SELTRA_IMAGE_CACHE_ENABLED=true
CF_IMAGE_HERO_MODEL=@cf/black-forest-labs/flux-2-dev
CF_IMAGE_PRODUCT_MODEL=@cf/black-forest-labs/flux-2-klein-9b
CF_IMAGE_DRAFT_MODEL=@cf/black-forest-labs/flux-2-klein-4b
CF_IMAGE_FALLBACK_MODEL=@cf/black-forest-labs/flux-1-schnell
NOTION_API_KEY=secret_...
NOTION_APPLICATIONS_DB_ID=

# Email (Resend) — needed for welcome / approval / password-reset emails
RESEND_API_KEY=
RESEND_FROM=Seltra <careers@send.seltra.co>
RESEND_NOTIFY_TO=
EMAIL_UNSUBSCRIBE_SECRET=replace-with-a-different-random-secret-at-least-32-characters
SELTRA_FRONTEND_URL=http://localhost:3000

# V5 run lifecycle and resilience
RUN_LEASE_TTL_SECONDS=900
RUN_HEARTBEAT_INTERVAL_SECONDS=5
STREAM_HEARTBEAT_SECONDS=10
STALL_NOTICE_SECONDS=20
STALL_DIAGNOSTIC_SECONDS=90
MAX_REPAIR_ATTEMPTS=3

# V5 concurrency / projects
MAX_CONCURRENT_RUNS_PER_WORKSPACE=2
SANDBOX_IDLE_REAP_MINUTES=20

# V5 credits
CREDITS_LOW_THRESHOLD_PCT=20
CREDITS_MIN_CHARGE_PER_CALL=1
CREDIT_WEIGHT_REASONING=1
CREDIT_WEIGHT_DEFAULT=1
CREDIT_WEIGHT_FAST=1
CREDIT_WEIGHT_VISION=2
CREDIT_WEIGHT_IMAGE=3
MODEL_MAX_TOKENS_PER_RUN=10000000
MODEL_MAX_TOKENS_PER_WORKSPACE=20000000
SELTRA_PRO_MAX_TOKENS_PER_WORKSPACE=100000000

# V5 feature flags
FF_RESUMABLE_STREAM=true
FF_WORKSPACE_PERSISTENCE=true
FF_CREDITS_METERING=true
FF_COMPLETION_SOUND=true


# Internal Ops dashboard (seltra-ops-platform)
OPS_INTERNAL_API_KEY=
OPS_INTERNAL_API_KEY_PREVIOUS=
OPS_ACTOR=admin@seltra.co
